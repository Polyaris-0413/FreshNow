<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读当前 WiFi 网络的地址（同步页要把它显示给对方看）。普通权限，装完就有 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 同步要持组播锁才能稳定收到 mDNS 报文，否则部分机型在省电时会静默收不到发现结果 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17（API 37）起局域网访问要用户授权，在那之前的系统上这个声明会被忽略。
         代码侧的开关见 SyncScreen 里的 hasLocalNetworkPermission -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreshNow">
        <!-- 锁定竖屏：本应用横屏没有任何功能收益（扫描要竖持对着标签、详情与编辑是竖排表单、
             主页是列表），而旋转会重建 Activity，是「状态被重置」最常见的入口。
             代价落在无障碍上：手部不便、习惯横握设备的用户不再能横屏使用，所以下面抑制
             LockedOrientationActivity 这条 lint。
             这不等于免除「状态要扛过重建」的责任：字号、深色模式、语言、分屏同样会重建，
             只是命中概率低得多。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FreshNow"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>