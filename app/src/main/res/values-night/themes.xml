<?xml version="1.0" encoding="utf-8"?>
<!-- 深色模式必须换成深色父主题：Window 背景色由主题决定，
     若始终沿用浅色主题，页面淡入淡出时半透明内容会透出浅色窗口背景（白闪） -->
<resources>

    <!-- 说明见 values/themes.xml；取值等于 DarkColorScheme 的 background（neutral tone 10） -->
    <color name="window_background">#1B1B1F</color>

    <style name="Theme.FreshNow.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.FreshNow" parent="Theme.FreshNow.Base" />
</resources>
