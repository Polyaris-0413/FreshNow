*.iml
.gradle
# Kotlin 2.x 的编译器会话数据；官方文档明确要求不入库（kotlinlang.org 的 Configure a Gradle project）
.kotlin/
local.properties

# IDE 配置用白名单式：只留跨机器共享的项目结构文件。
# 枚举式（逐个 xml 忽略）会让 Android Studio 新生成的文件以「未跟踪」冒出来而被误提交——
# 尤其 .idea/deviceManager.xml 含本机设备信息，.idea/compiler.xml 记的是本机 JDK 派生的
# 字节码目标（本机是 25，而项目编译目标是 Java 11）。
/.idea/*
!/.idea/AndroidProjectSystem.xml
!/.idea/gradle.xml
# AS 勾「Store as project file」的 run 配置存进目录而不是 runConfigurations.xml。父目录已被
# /.idea/* 忽略，此时只否定目录里的 *.xml 不生效，必须目录与文件各写一行。
!/.idea/runConfigurations/
!/.idea/runConfigurations/*.xml
!/.idea/runConfigurations.xml
!/.idea/vcs.xml

.DS_Store
Thumbs.db
Desktop.ini

# 构建产物不锚定：这样将来新增模块的 build/ 也自动被忽略
build/
captures/
.externalNativeBuild
.cxx
*.hprof
# Gradle daemon 崩溃时 JVM 把这两个日志直接丢在进程工作目录（即仓库根）
hs_err_pid*.log
replay_pid*.log

# AS 向导（Generate Signed APK / Bundle）与 Build APK(s) 的产物按文件名兜，不枚举 <module>/<变体>/：
# 里面有已签名的 apk 与 R8 的 mapping.txt（mapping.txt 能把发布包反混淆，绝不该入库），
# 而枚举目录必然漏掉新变体（debugAlt、nonMinifiedRelease 就是这么来的）。
# 要发布用 GitHub Releases，git add -f 可强制。*.idsig 是 apk 的 v4 签名伴随文件。
*.apk
*.aab
*.idsig
mapping.txt
# 同一批产物里还带一份 AS 写的元数据：<module>/<变体>/output-metadata.json。
output-metadata.json

# 发布签名材料：私钥与口令一旦入库即不可撤销
*.jks
*.keystore
*.p12
*.pk8
keystore.properties

# tools/generate-color-scheme.cjs 的依赖：清单入库以便在新机器上复现，依赖本体不入库。
# 不锚定，免得将来某个子目录自带 package.json 时依赖漏进来
node_modules/

# 头脑风暴视觉伴侣（superpowers）的会话文件：只在本机看图用，与构建无关
/.superpowers/
